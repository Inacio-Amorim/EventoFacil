# ============================================================
# EventoFácil - variáveis de ambiente do backend
#
# 1. Copie este arquivo para "backend/.env"
# 2. Preencha os valores
# 3. NUNCA envie o arquivo .env para o GitHub (ele está no .gitignore)
# ============================================================

# ---------------- Banco de dados (MySQL 8) ----------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql
DB_NAME=eventofacil

# ---------------- Segurança ----------------
# Qualquer texto longo e aleatório (assina o cookie de sessão)
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio

# Senha da área da coordenação (http://localhost:5000/admin)
ADMIN_SENHA=defina-uma-senha-para-a-coordenacao

# ---------------- Azure AI Foundry (assistente) ----------------
# Mesmos dados do modelo do curso: Ponto de Extremidade, Chave API e Agente.
# ATENÇÃO: use o "Ponto de extremidade do PROJETO" (services.ai.azure.com),
# não o endpoint do OpenAI (openai.azure.com).
AZURE_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com/api/projects/SEU-PROJETO
AZURE_API_KEY=cole-sua-chave-aqui
AZURE_AGENT_NAME=agente-eventofacil
AZURE_API_VERSION=2025-11-15-preview

# ---------------- E-mail (código de confirmação) ----------------
# Deixe SMTP_HOST vazio para testar sem e-mail: o código aparece
# no terminal onde o backend está rodando.
#
# Gmail: ative a verificação em 2 etapas e crie uma "senha de app"
# em https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=seu.email@gmail.com
SMTP_SENHA=senha-de-app-de-16-letras
SMTP_REMETENTE=EventoFácil <seu.email@gmail.com>
